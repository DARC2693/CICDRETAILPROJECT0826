{
  "datasets": [
    {
      "name": "701fa994",
      "displayName": "kpi_summary",
      "queryLines": [
        "--- Dataset 1: kpi_summary (para 3 tarjetas KPI) ---\r\n",
        "SELECT\r\n",
        "  SUM(total_sales)  AS total_sales,\r\n",
        "  SUM(total_profit) AS total_profit,\r\n",
        "  SUM(num_orders)   AS total_orders\r\n",
        "FROM retail_medallion.golden.agg_sales_by_category_month;"
      ]
    },
    {
      "name": "198eb324",
      "displayName": "sales_trend_by_channel",
      "queryLines": [
        "--- Dataset 2: sales_trend_by_channel (línea, tendencia mensual) ---\r\n",
        "SELECT year_month, source_system, SUM(total_sales) AS total_sales\r\n",
        "FROM retail_medallion.golden.agg_sales_by_category_month\r\n",
        "GROUP BY year_month, source_system\r\n",
        "ORDER BY year_month;"
      ]
    },
    {
      "name": "c48cd78b",
      "displayName": "sales_by_category",
      "queryLines": [
        "--- Dataset 3: sales_by_category (barras, top categorías) ---\r\n",
        "SELECT category, source_system, SUM(total_sales) AS total_sales\r\n",
        "FROM retail_medallion.golden.agg_sales_by_category_month\r\n",
        "GROUP BY category, source_system\r\n",
        "ORDER BY total_sales DESC;"
      ]
    },
    {
      "name": "5abfff60",
      "displayName": "holiday_comparison",
      "queryLines": [
        "--- Dataset 4: holiday_comparison (barras, feriado vs normal) ---\r\n",
        "SELECT\r\n",
        "  CASE WHEN is_holiday THEN 'Feriado' ELSE 'Día normal' END AS tipo_dia,\r\n",
        "  source_system,\r\n",
        "  SUM(total_sales) AS total_sales,\r\n",
        "  AVG(avg_order_value) AS avg_order_value\r\n",
        "FROM retail_medallion.golden.agg_sales_by_holiday\r\n",
        "GROUP BY is_holiday, source_system;"
      ]
    },
    {
      "name": "e54e9a58",
      "displayName": "marketing_roi_trend",
      "queryLines": [
        "--- Dataset 5: marketing_roi_trend (línea, solo e-commerce) ---\r\n",
        "SELECT year_month, category, roi, total_marketing_spend, total_sales\r\n",
        "FROM retail_medallion.golden.ecommerce_marketing_roi\r\n",
        "ORDER BY year_month;"
      ]
    },
    {
      "name": "fe14b9ae",
      "displayName": "sales_by_region",
      "queryLines": [
        "--- Dataset 6: sales_by_region (barras, solo Superstore) ---\r\n",
        "SELECT region, SUM(sales_amount) AS total_sales, SUM(profit_amount) AS total_profit\r\n",
        "FROM retail_medallion.golden.fact_sales\r\n",
        "GROUP BY region\r\n",
        "ORDER BY total_sales DESC;"
      ]
    }
  ],
